{
  "name": "deskroid",
  "productName": "Deskroid",
  "version": "0.1.0",
  "description": "デスクトップに常駐して話せるキャラクター（Live2D / 3D・Ollama・VOICEVOX / Kokoro・Whisper）",
  "author": "mkosei",
  "homepage": "https://github.com/mkosei/deskroid",
  "repository": "github:mkosei/deskroid",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@pixiv/three-vrm": "^3.5.5",
    "kokoro-js": "^1.2.1",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.18.0"
  },
  "license": "MIT",
  "build": {
    "appId": "com.mkosei.deskroid",
    "productName": "Deskroid",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!models/**",
      "!scripts/**",
      "!dist/**",
      "!config.local.json",
      "!*.log",
      "!CLAUDE.md",
      "!README.md",
      "!.github/**",
      "!build/**",
      "!docs/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "mkosei",
      "repo": "deskroid",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/{darwin,linux}/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Deskroid",
      "artifactName": "Deskroid-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "声でキャラに話しかけるためにマイクを使います。"
      },
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v3/{win32,linux}/**"
      ]
    },
    "dmg": {
      "artifactName": "Deskroid-${version}-${arch}.${ext}"
    }
  }
}
